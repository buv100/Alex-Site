# Copy to .env.local and fill in. Never commit real secrets.

# Required for Phase 2 (server mode) — free managed Mongo (OVH Discovery / Clever Cloud / Atlas M0)
# OVH example: mongodb://user:pass@hostname:27017/alex-nekasim?replicaSet=...
# Atlas example:
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/alex-nekasim?retryWrites=true&w=majority
AUTH_SECRET=generate-a-long-random-string

# Cloudinary (image upload from phone)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional seed endpoint header
SEED_SECRET=dev-seed-secret
