# Copy to .env.local and fill in. Never commit real secrets.

# Required for Phase 2 (server mode) — free managed Mongo (OVH Discovery / Clever Cloud / Atlas M0)
# OVH example: mongodb://user:pass@hostname:27017/alex-nekasim?replicaSet=...
# Atlas example:
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/alex-nekasim?retryWrites=true&w=majority
AUTH_SECRET=generate-a-long-random-string

# Admin login (env-based — preferred for single admin)
ADMIN_USERNAME=alex
ADMIN_PASSWORD=change-me-strong-password
ADMIN_EMAIL=leads@example.com

# Optional: bcrypt hash instead of plaintext ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# Cloudinary (image upload from phone)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional seed endpoint header
SEED_SECRET=dev-seed-secret

# Optional: expose /admin only when set (production)
# ENABLE_ADMIN=true
# PUBLIC_SITE_ONLY=true

# Required in production with ENABLE_ADMIN: secret entry token (not in git / not in README).
# Open /admin/login?access=YOUR_SECRET once — sets httpOnly cookie, then password login.
# ADMIN_ENTRY_SECRET=
